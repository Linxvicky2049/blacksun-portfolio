  .project-menu { scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; }
  .project-tile { scroll-snap-align: center; }
  .project-card-actions a { flex: 1 1 100%; }
  #cursor-reveal { opacity: .94; }
}
@media (prefers-reduced-motion: reduce) {
  #cursor-reveal { display: none; }
}


/* Professional credentials */
.credentials-section .credential-card {
  display: grid;
  grid-template-columns: minmax(220px, 0.72fr) minmax(0, 1.5fr);
  gap: clamp(1.5rem, 4vw, 3.5rem);
  align-items: center;
  padding: clamp(1.25rem, 3vw, 2.5rem);
  border: 1px solid rgba(143, 190, 255, .2);
  border-radius: 24px;
  background: linear-gradient(135deg, rgba(15, 25, 42, .92), rgba(7, 11, 18, .88));
  box-shadow: 0 24px 70px rgba(0, 0, 0, .22);
}
.credential-art {
  min-height: 230px;
  display: grid;
  place-items: center;
  position: relative;
  overflow: hidden;
  border-radius: 18px;
  background:
    radial-gradient(circle at 50% 45%, rgba(34, 211, 238, .22), transparent 42%),
    linear-gradient(145deg, rgba(30, 91, 180, .28), rgba(10, 18, 32, .9));
  border: 1px solid rgba(104, 170, 255, .24);
}
.credential-art::before,
.credential-art::after {
  content: "";
  position: absolute;
  width: 190px;
  height: 190px;
  border: 1px solid rgba(111, 194, 255, .24);
  border-radius: 50%;
}
.credential-art::after { width: 145px; height: 145px; border-style: dashed; }
.credential-seal {
  z-index: 1;
  width: 112px;
  height: 112px;
  display: grid;
  place-content: center;
  text-align: center;
  border-radius: 50%;
  color: #eaf6ff;
  font: 800 1.65rem/1 "Space Grotesk", sans-serif;
  background: linear-gradient(145deg, #1762c4, #092c63);
  border: 4px solid #36d6ce;
  box-shadow: 0 0 35px rgba(54, 214, 206, .22);
}
.credential-seal small { font: 700 .58rem/1.4 "JetBrains Mono", monospace; letter-spacing: .12em; }
.credential-code {
  position: absolute;
  bottom: 15px;
  color: rgba(220, 235, 255, .58);
  font: 500 .68rem "JetBrains Mono", monospace;
  letter-spacing: .12em;
}
.credential-issuer {
  margin: 0 0 .45rem;
  color: #68d8e6;
  font: 700 .75rem "JetBrains Mono", monospace;
  letter-spacing: .14em;
  text-transform: uppercase;
}
.credential-copy h3 { margin: 0 0 .8rem; font-size: clamp(1.6rem, 3vw, 2.4rem); }
.credential-copy > p:not(.credential-issuer) { max-width: 650px; color: var(--muted, #aab4c4); line-height: 1.75; }
.credential-meta { display: flex; flex-wrap: wrap; gap: .7rem 1.2rem; margin: 1.2rem 0 1.5rem; color: var(--muted, #aab4c4); font-size: .88rem; }
.credential-meta strong { color: #eef5ff; }
.credential-actions { display: flex; flex-wrap: wrap; gap: .75rem; }
@media (max-width: 720px) {
  .credentials-section .credential-card { grid-template-columns: 1fr; }
  .credential-art { min-height: 185px; }
  .credential-actions .button { width: 100%; justify-content: center; }
}

/* ==========================================
   BLACKSUN NAVIGATION REPAIR
   Desktop + Mobile + Glass Transparency
   ========================================== */

.topbar {
  position: sticky !important;
  top: 10px;
  z-index: 1000 !important;
  isolation: isolate;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: clamp(10px, 1.5vw, 22px);
  background: rgba(5, 10, 18, 0.82) !important;
  border: 1px solid rgba(150, 190, 220, 0.18);
  backdrop-filter: blur(24px) saturate(155%);
  -webkit-backdrop-filter: blur(24px) saturate(155%);
  box-shadow:
    0 12px 40px rgba(0, 0, 0, 0.30),
    inset 0 1px 0 rgba(255, 255, 255, 0.06);
}

.topbar > * {
  min-width: 0;
}

.brand {
  flex-shrink: 0;
}

.nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(10px, 1.3vw, 22px);
  min-width: 0;
}

.nav a,
.nav button {
  white-space: nowrap;
}

.nav-project-list {
  z-index: 1100;
  background: rgba(7, 13, 23, 0.96);
  border: 1px solid rgba(150, 190, 220, 0.20);
  backdrop-filter: blur(24px) saturate(160%);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  box-shadow: 0 18px 45px rgba(0, 0, 0, 0.45);
}

.nav-cta,
.account-button,
.menu-toggle {
  flex-shrink: 0;
}

.menu-toggle {
  position: relative;
  z-index: 1200;
  cursor: pointer;
}

/* Prevent the page content from covering the menu */
main,
footer {
  position: relative;
  z-index: 1;
}

/* Tablet and smaller screens */
@media (max-width: 900px) {
  .topbar {
    width: calc(100% - 24px);
    padding: 13px 16px;
    gap: 12px;
  }

  .brand {
    margin-right: auto;
  }
}

/* Mobile navigation */
@media (max-width: 760px) {
  .topbar {
    position: sticky !important;
    top: 8px;
    z-index: 1000 !important;
    flex-wrap: nowrap;
    padding: 12px 14px;
    border-radius: 18px;
  }

  .menu-toggle {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .menu-toggle span {
    width: 19px;
    height: 2px;
    border-radius: 5px;
    background: var(--ink);
  }

  .nav {
    position: absolute !important;
    top: calc(100% + 10px) !important;
    left: 0 !important;
    right: 0 !important;
    width: 100%;
    max-height: min(72vh, 560px);
    display: none;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: 5px;
    padding: 16px;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid rgba(150, 190, 220, 0.22);
    border-radius: 18px;
    background: rgba(5, 10, 19, 0.96) !important;
    backdrop-filter: blur(28px) saturate(160%);
    -webkit-backdrop-filter: blur(28px) saturate(160%);
    box-shadow: 0 22px 55px rgba(0, 0, 0, 0.55);
    z-index: 1100;
  }

  .nav.open {
    display: flex !important;
  }

  .nav a {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 42px;
    padding: 10px 12px;
    border-radius: 10px;
    white-space: normal;
  }

  .nav a:hover,
  .nav a:focus-visible {
    background: rgba(255, 255, 255, 0.07);
  }

  .nav-project-group,
  .project-nav-group {
    width: 100%;
  }

  .nav-project-toggle {
    width: 100%;
    min-height: 42px;
    justify-content: space-between;
  }

  .nav-project-list {
    position: static !important;
    width: 100%;
    max-height: 240px;
    overflow-y: auto;
    margin-top: 8px;
    padding: 8px;
    border-radius: 12px;
    box-shadow: none;
  }

  .nav-icon-button {
    width: 100%;
    min-height: 42px;
    justify-content: flex-start;
  }

  .nav-cta {
    display: none !important;
  }

  .account-button {
    min-height: 42px;
  }
}

/* Small phones */
@media (max-width: 420px) {
  .topbar {
    width: calc(100% - 20px);
    padding: 10px 12px;
  }

  .brand-text {
    font-size: 0.95rem;
  }

  .brand-mark img {
    max-width: 36px;
  }

  .nav {
    padding: 12px;
  }
}

/* Browser fallback */
@supports not (backdrop-filter: blur(1px)) {
  .topbar,
  .nav,
  .nav-project-list {
    background: rgba(5, 10, 19, 0.97) !important;
  }
}

