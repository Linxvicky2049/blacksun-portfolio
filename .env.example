# Portfolio Backend Configuration

# Server Port
PORT=3000

# Email Configuration (Gmail or your email service)
# <<< REQUIRED: Replace EMAIL_USER and EMAIL_PASSWORD with your actual sender account details.
EMAIL_SERVICE=gmail
EMAIL_USER=REPLACE_WITH_YOUR_EMAIL_ADDRESS
EMAIL_PASSWORD=REPLACE_WITH_YOUR_EMAIL_APP_PASSWORD

# Environment
NODE_ENV=development

# Set to the exact frontend origin for a separate frontend/backend deployment.
# The default '*' permits cross-origin requests, but production deployments should use their site origin.
CORS_ORIGIN=*

# Firebase Authentication and Firestore
# Enable Google and Email/Password providers in Firebase Authentication.
# <<< REQUIRED: Copy these values from your Firebase web app configuration.
FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
FIREBASE_AUTH_DOMAIN=REPLACE_WITH_FIREBASE_AUTH_DOMAIN
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_APP_ID
FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_FIREBASE_MESSAGING_SENDER_ID

# Server-only Firebase service account JSON; never expose or commit this value.
# <<< REQUIRED for persistent login/admin features: paste the service account JSON as one line.
FIREBASE_SERVICE_ACCOUNT_JSON=REPLACE_WITH_FIREBASE_SERVICE_ACCOUNT_JSON

# The only email permitted to manage portfolio content. This account must verify its email.
# <<< REQUIRED: Set this to your verified super-admin login email.
ADMIN_EMAIL=REPLACE_WITH_YOUR_SUPER_ADMIN_EMAIL

# Notes:
# For Gmail:
# 1. Enable 2-Factor Authentication in your Google Account
# 2. Go to myaccount.google.com/apppasswords
# 3. Select Mail and Windows Computer
# 4. Copy the generated password and paste it in EMAIL_PASSWORD
#
# Copy this file to .env and replace every REPLACE_WITH_... value before starting
# the server. Keep .env private; it is excluded from source control.